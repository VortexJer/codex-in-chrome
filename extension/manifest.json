{
 "manifest_version": 3,
 "name": "Codex in Chrome",
 "version": "1.0.0",
 "description": "Lets Codex CLI drive Chrome through a local MCP bridge. Token-lean snapshots.",
 "key": "",
 "permissions": [
  "tabs",
  "tabGroups",
  "scripting",
  "debugger",
  "alarms",
  "storage",
  "sidePanel"
 ],
 "host_permissions": [
  "<all_urls>"
 ],
 "background": {
  "service_worker": "background.js"
 },
 "content_scripts": [
  {
   "matches": [
    "<all_urls>"
   ],
   "js": [
    "cx.js"
   ],
   "all_frames": true,
   "run_at": "document_start"
  }
 ],
 "action": {
  "default_title": "Codex in Chrome"
 },
 "options_page": "permissions.html",
 "side_panel": {
  "default_path": "permissions.html"
 }
}